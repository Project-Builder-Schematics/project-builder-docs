---
import Default from "@astrojs/starlight/components/Head.astro";

// Point social previews at the per-page image generated by src/pages/open-graph/.
const { id } = Astro.locals.starlightRoute;
const ogImageUrl = new URL(`/open-graph/${id || "index"}.png`, Astro.site);
---

<script is:inline>
	// Default first-time visitors to dark; the theme switcher still offers both.
	if (!localStorage.getItem('starlight-theme')) localStorage.setItem('starlight-theme', 'dark');
</script>

<Default><slot /></Default>

<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:image" content={ogImageUrl} />
